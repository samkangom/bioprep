# ---------------------------------------------------------------------------
# Frontend (Vite). Copy to .env.local. Only VITE_* values reach the browser,
# and all of them are public by design. Never put a secret here.
# ---------------------------------------------------------------------------
# Leave the Supabase values empty (or set VITE_USE_MOCK=1) to run the offline localStorage prototype.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK=
# URL of the Node API (tutor, explanations, videos, payments). Example: http://localhost:8787
VITE_API_URL=
