# ---------------------------------------------------------------------------
# Frontend (Vite). Copy to .env.local. Only VITE_* values reach the browser,
# and all of them are public by design. Never put a secret here.
# ---------------------------------------------------------------------------
# Leave the Supabase values empty (or set VITE_USE_MOCK=1) to run the offline localStorage prototype.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK=
# URL of the Node API (tutor, explanations, videos, payments). Example: http://localhost:8787
VITE_API_URL=

# ---------------------------------------------------------------------------
# API (server/). SECRETS. Set these in your Node host's environment, never in the browser or the repo.
# ---------------------------------------------------------------------------
# Supabase Postgres connection string (Project settings > Database). Use the pooled string for serverless hosts.
DATABASE_URL=
SUPABASE_URL=
# Project settings > API > service_role. Bypasses RLS. API only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Without it the tutor uses the built-in scripted guide.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high. Short tutor turns do fine at low.
CLAUDE_EFFORT=low
# Claude turns per student per rolling 24 hours. After that the scripted guide answers.
TUTOR_DAILY_LIMIT=60
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Lifetime of a signed video URL, in seconds.
VIDEO_URL_TTL_SECONDS=600
PORT=8787
# Set to "disable" for a local Postgres without TLS.
PG_SSL=
